# Vespera server settings. Keep this file private - never commit or share it.

# Catalog data (required) and ratings/awards (optional)
TMDB_KEY=
OMDB_KEY=

# Where the site is reachable. Use your real https:// address when you put it online.
PORT=5173
# 127.0.0.1 = this computer only. Use 0.0.0.0 when hosting online.
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173

# Invite-only sign-in (true/false). Invite people with: node server.js invite friend@example.com
INVITE_ONLY=true

# Email sign-in codes via Resend (https://resend.com). Leave blank to print codes in the server window instead.
RESEND_API_KEY=
MAIL_FROM=

# Google sign-in (https://console.cloud.google.com/apis/credentials, OAuth client "Web application").
# Authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# AI assistant (Claude). Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
ASSISTANT_MODEL=
